{
  "$id": "brief/0.1",
  "title": "The spec of a Brief",
  "description": "The agent writes this file (brief.json). The script render makes the page from it. Every path is relative to the Flint root. Inline text accepts **bold**, `code`, and [label](path or URL). A string limit is in maxLength; an array limit is in maxItems.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "title",
    "date",
    "lede",
    "health",
    "stats",
    "sections"
  ],
  "properties": {
    "schema": {
      "const": "brief/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The date and the slug of the title. The browser keeps the answers to the decisions under it."
    },
    "kind": {
      "enum": [
        "fleet",
        "status",
        "architecture",
        "explainer"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tz": {
      "type": "string",
      "pattern": "^[+-]\\d{2}:\\d{2}$",
      "description": "The time zone of the times on the page, for example +11:00."
    },
    "eyebrow": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 60
      },
      "description": "Short labels above the title: the kind, the scope, the time window."
    },
    "lede": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600,
      "description": "The bottom line in at most 3 sentences."
    },
    "ledeEvidence": {
      "$ref": "#/$defs/evidence",
      "description": "The facts of the numbers and the names in the lede. The page shows them after the lede."
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "asOf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "description": "An ISO time."
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/stat"
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "scope": {
      "type": "object",
      "description": "Free fields that name what the Brief covers, for example { \"fleet\": \"nuu-apps-1016\", \"task\": \"Task 1274\" }."
    },
    "factsFile": {
      "type": "string",
      "description": "The facts.json of collect, relative to brief.json. The default is facts.json beside it."
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      },
      "description": "The facts that the agent adds. Each one has a source; a fact from a Mesh note quotes it."
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
      }
    },
    "basis": {
      "enum": [
        "observed",
        "inferred"
      ]
    },
    "tone": {
      "enum": [
        "earth",
        "sun",
        "fire",
        "water",
        "air",
        "moon",
        "storm",
        "ocean"
      ]
    },
    "status": {
      "enum": [
        "done",
        "landed",
        "pass",
        "fixed",
        "partial",
        "at-risk",
        "open",
        "mitigated",
        "deferred",
        "failed",
        "blocked",
        "fail",
        "running",
        "info",
        "review",
        "skipped",
        "na",
        "accepted"
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "href": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string",
          "maxLength": 240
        },
        "env": {
          "$ref": "#/$defs/env"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "label"
      ],
      "properties": {
        "state": {
          "enum": [
            "landed",
            "at-risk",
            "blocked",
            "info"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "why": {
          "type": "string",
          "maxLength": 700
        },
        "options": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "recommend": {
          "type": "string",
          "maxLength": 80
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "basis"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 600
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/b_text"
        },
        {
          "$ref": "#/$defs/b_claims"
        },
        {
          "$ref": "#/$defs/b_callout"
        },
        {
          "$ref": "#/$defs/b_stats"
        },
        {
          "$ref": "#/$defs/b_board"
        },
        {
          "$ref": "#/$defs/b_table"
        },
        {
          "$ref": "#/$defs/b_cards"
        },
        {
          "$ref": "#/$defs/b_changes"
        },
        {
          "$ref": "#/$defs/b_failures"
        },
        {
          "$ref": "#/$defs/b_retro"
        },
        {
          "$ref": "#/$defs/b_timeline"
        },
        {
          "$ref": "#/$defs/b_diagram"
        },
        {
          "$ref": "#/$defs/b_gallery"
        },
        {
          "$ref": "#/$defs/b_compare"
        },
        {
          "$ref": "#/$defs/b_steps"
        },
        {
          "$ref": "#/$defs/b_commands"
        },
        {
          "$ref": "#/$defs/b_code"
        },
        {
          "$ref": "#/$defs/b_details"
        }
      ]
    },
    "b_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "description": "Prose. Separate paragraphs with a blank line.",
      "properties": {
        "type": {
          "const": "text"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "b_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "description": "A list of claims. Each one is observed or inferred and cites its facts.",
      "properties": {
        "type": {
          "const": "claims"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "b_callout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tone",
        "text"
      ],
      "properties": {
        "type": {
          "const": "callout"
        },
        "tone": {
          "enum": [
            "info",
            "ok",
            "warn",
            "risk"
          ]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 800
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "b_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "stats"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/stat"
          }
        }
      }
    },
    "b_board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "stages",
        "rows"
      ],
      "description": "The fleet at a glance: one row for each lane, one cell for each stage.",
      "properties": {
        "type": {
          "const": "board"
        },
        "title": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 24
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane",
              "health"
            ],
            "properties": {
              "lane": {
                "type": "string",
                "maxLength": 40
              },
              "sub": {
                "type": "string",
                "maxLength": 80
              },
              "health": {
                "enum": [
                  "landed",
                  "at-risk",
                  "blocked",
                  "info"
                ]
              },
              "cells": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/status"
                },
                "description": "{ \"<stage>\": \"<status>\" }. A stage with no cell shows as not applicable."
              },
              "note": {
                "type": "string",
                "maxLength": 400
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        }
      }
    },
    "b_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "title": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "status": {
                      "$ref": "#/$defs/status"
                    },
                    "evidence": {
                      "$ref": "#/$defs/evidence"
                    }
                  }
                }
              ]
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "b_cards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "cards"
        },
        "title": {
          "type": "string"
        },
        "columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 80
              },
              "sub": {
                "type": "string",
                "maxLength": 120
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "statusLabel": {
                "type": "string",
                "maxLength": 32
              },
              "text": {
                "type": "string",
                "maxLength": 900
              },
              "claims": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/claim"
                }
              },
              "image": {
                "$ref": "#/$defs/image"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/link"
                }
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                }
              },
              "detailsLabel": {
                "type": "string",
                "maxLength": 60
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        }
      }
    },
    "b_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "groups"
      ],
      "description": "What changed, in the groups of a changelog (Added, Changed, Fixed, Removed, or others).",
      "properties": {
        "type": {
          "const": "changes"
        },
        "title": {
          "type": "string"
        },
        "diffstat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "insertions",
            "deletions"
          ],
          "properties": {
            "files": {
              "type": "integer"
            },
            "insertions": {
              "type": "integer"
            },
            "deletions": {
              "type": "integer"
            },
            "label": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "items"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "tone": {
                "$ref": "#/$defs/tone"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "evidence": {
                      "$ref": "#/$defs/evidence"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "b_failures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "description": "What failed: the symptom, the cause (observed or inferred), what was tried, and the state now.",
      "properties": {
        "type": {
          "const": "failures"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "symptom",
              "cause",
              "basis",
              "state"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 100
              },
              "symptom": {
                "type": "string",
                "maxLength": 500
              },
              "cause": {
                "type": "string",
                "maxLength": 500
              },
              "basis": {
                "$ref": "#/$defs/basis"
              },
              "tried": {
                "type": "string",
                "maxLength": 500
              },
              "state": {
                "enum": [
                  "fixed",
                  "mitigated",
                  "open",
                  "deferred",
                  "accepted"
                ],
                "description": "mitigated: the symptom is gone, but the cause stays."
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        }
      }
    },
    "b_retro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "Went well, went wrong, got lucky.",
      "properties": {
        "type": {
          "const": "retro"
        },
        "title": {
          "type": "string"
        },
        "well": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/claim"
              }
            ]
          }
        },
        "wrong": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/claim"
              }
            ]
          }
        },
        "lucky": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/claim"
              }
            ]
          }
        }
      }
    },
    "b_timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "Swimlanes of time. \"derived\": \"timeline\" takes the lanes and the spans from facts.json (collect --kind fleet).",
      "properties": {
        "type": {
          "const": "timeline"
        },
        "title": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "derived": {
          "const": "timeline"
        },
        "laneNames": {
          "type": "object",
          "description": "{ \"<lane key>\": \"<name>\" } to rename a derived lane."
        },
        "hide": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The keys of derived lanes to leave out."
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "spans"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              },
              "spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "string"
                    },
                    "end": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "row": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "label"
            ],
            "properties": {
              "at": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "bands": {
          "type": "array",
          "maxItems": 6,
          "description": "Ranges of time across all lanes, for example a hold or a freeze.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "label"
            ],
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "tone": {
                "$ref": "#/$defs/tone"
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        }
      }
    },
    "b_diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "nodes",
        "edges"
      ],
      "description": "A diagram of at most 9 nodes, laid out from left to right. Paths step through the nodes.",
      "properties": {
        "type": {
          "const": "diagram"
        },
        "title": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "label": {
                "type": "string",
                "maxLength": 28
              },
              "note": {
                "type": "string",
                "maxLength": 40
              },
              "tone": {
                "$ref": "#/$defs/tone"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "maxLength": 28
              }
            }
          }
        },
        "paths": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "steps"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 40
              },
              "steps": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "string"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "b_gallery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "gallery"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src",
              "caption"
            ],
            "properties": {
              "src": {
                "type": "string"
              },
              "caption": {
                "type": "string",
                "maxLength": 240
              },
              "tall": {
                "type": "boolean"
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              },
              "env": {
                "$ref": "#/$defs/env"
              }
            }
          }
        }
      }
    },
    "b_compare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "before",
        "after"
      ],
      "properties": {
        "type": {
          "const": "compare"
        },
        "title": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/image"
        },
        "after": {
          "$ref": "#/$defs/image"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "b_steps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "steps"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "text"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 80
              },
              "text": {
                "type": "string",
                "maxLength": 600
              },
              "code": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "b_commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "commands"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "cmd"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 160
              },
              "cmd": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "b_code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "code"
        },
        "title": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "b_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "blocks"
      ],
      "description": "A part that the reader opens: level 2 and level 3 detail.",
      "properties": {
        "type": {
          "const": "details"
        },
        "title": {
          "type": "string"
        },
        "open": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 1200
        },
        "kind": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "git",
                "orbh",
                "mesh",
                "media",
                "command",
                "url",
                "file"
              ]
            },
            "ref": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "quote": {
              "type": "string",
              "maxLength": 600,
              "description": "Words copied exactly from the file at path. check finds them in the file."
            }
          }
        }
      }
    },
    "env": {
      "enum": [
        "dev",
        "staging",
        "prod",
        "local"
      ],
      "description": "Where a screenshot was taken. The page shows it as a tag."
    }
  }
